---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PortableText from '../../components/PortableText.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { loadQuery } from '../../sanity/lib/load-query';
import {
  serviceSlugsQuery,
  serviceBySlugQuery,
  testimonialsByServiceQuery,
  projectsByServiceQuery,
  businessInfoQuery,
} from '../../sanity/lib/queries';

export async function getStaticPaths() {
  const slugs = await loadQuery<any[]>({ query: serviceSlugsQuery });
  return (slugs || []).map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = await loadQuery<any>({ query: serviceBySlugQuery, params: { slug } });

if (!service) return Astro.redirect('/404');

const testimonials = await loadQuery<any[]>({
  query: testimonialsByServiceQuery,
  params: { serviceId: service._id },
});
const projects = await loadQuery<any[]>({
  query: projectsByServiceQuery,
  params: { serviceId: service._id },
});

const businessInfo = await loadQuery<any>({ query: businessInfoQuery });
const phoneDigits = businessInfo?.phone?.replace(/[^\d+]/g, '') || '';
const site = Astro.site?.href?.replace(/\/$/, '') || 'https://ashorepainting.com';
const breadcrumbs = [
  { label: 'Home', url: '/' },
  { label: 'Services', url: '/services' },
  { label: service.title, url: `/services/${slug}` },
];

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.shortDescription || service.seo?.metaDescription,
  provider: {
    '@type': 'HousePainter',
    '@id': `${site}/#business`,
  },
  areaServed: {
    '@type': 'City',
    name: 'St. Augustine',
    '@id': 'https://en.wikipedia.org/wiki/St._Augustine,_Florida',
  },
  serviceType: service.title,
  url: `${site}/services/${slug}`,
};

const validFaqs = service.faqs?.filter((faq: any) => faq?.question) || [];
const faqJsonLd = validFaqs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: validFaqs.map((faq: any) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer?.map((block: any) =>
            block.children?.map((child: any) => child.text).join('')
          ).join(' ') || '',
        },
      })),
    }
  : null;

const jsonLd = [serviceJsonLd, faqJsonLd].filter(Boolean);
---

<Layout
  title={service.seo?.metaTitle || service.title}
  description={service.seo?.metaDescription || service.shortDescription}
  ogImage={service.seo?.ogImage || service.mainImage}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />

    <article class="section service-page">
      <h1>{service.title} in St. Augustine, FL</h1>

      {service.body && (
        <div class="service-body">
          <PortableText value={service.body} />
        </div>
      )}

      {/* Pricing */}
      {service.priceRange && (
        <div class="pricing-callout">
          <h2>Pricing</h2>
          <p class="price-range">{service.priceRange}</p>
          <p class="price-note">Every project is unique. <a href={`tel:${phoneDigits}`}>Call for a free estimate</a>.</p>
        </div>
      )}

      {/* Our Process */}
      {service.processSteps && service.processSteps.length > 0 && (
        <section class="service-section">
          <h2>Our Process</h2>
          <ol class="process-steps">
            {service.processSteps.map((step: any, i: number) => (
              <li class="process-step">
                <span class="step-number">{i + 1}</span>
                <div>
                  <h3>{step.title}</h3>
                  {step.description && <p>{step.description}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      <!-- Related Projects -->
      {projects && projects.length > 0 && (
        <section class="service-section">
          <h2>Recent {service.title} Projects</h2>
          <div class="grid-3">
            {projects.map((proj: any) => (
              <ProjectCard project={proj} />
            ))}
          </div>
        </section>
      )}

      <!-- Testimonials -->
      {testimonials && testimonials.length > 0 && (
        <section class="service-section">
          <h2>What Clients Say About Our {service.title}</h2>
          <div class="grid-2">
            {testimonials.map((t: any) => (
              <TestimonialCard testimonial={t} />
            ))}
          </div>
        </section>
      )}

      <!-- FAQs -->
      {validFaqs.length > 0 && (
        <section class="service-section">
          <h2>Frequently Asked Questions</h2>
          {validFaqs.map((faq: any) => (
            <details class="faq-item">
              <summary>{faq.question}</summary>
              <div class="faq-answer">
                <PortableText value={faq.answer} />
              </div>
            </details>
          ))}
        </section>
      )}

      <!-- CTA -->
      <section class="service-cta">
        <h2>Ready to Get Started?</h2>
        <p>Call us for a free, no-obligation estimate on your {service.title.toLowerCase()} project.</p>
        <a href={`tel:${phoneDigits}`} class="btn btn-phone">
          <span aria-hidden="true">&#9742;</span> {businessInfo?.phone || 'Call Now'}
        </a>
      </section>
    </article>
  </div>
</Layout>

<style>
  .service-page h1 { margin-bottom: 24px; }
  .service-body { max-width: 780px; margin-bottom: 48px; }
  .service-section { margin-top: 64px; }
  .service-section h2 { margin-bottom: 24px; }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    margin-bottom: 8px;
    overflow: hidden;
  }

  .faq-item summary {
    padding: 16px 20px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item[open] summary {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-answer {
    padding: 16px 20px;
  }

  .pricing-callout {
    background: var(--color-accent-light);
    border-left: 4px solid var(--color-accent);
    padding: 24px 28px;
    border-radius: 0 8px 8px 0;
    margin-bottom: 48px;
    max-width: 500px;
  }

  .pricing-callout h2 { font-size: 1rem; margin-bottom: 8px; }

  .price-range {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 8px;
  }

  .price-note {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .process-steps { list-style: none; padding: 0; max-width: 700px; }
  .process-step { display: flex; gap: 20px; margin-bottom: 24px; align-items: flex-start; }
  .step-number {
    flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%;
    background: var(--color-primary); color: var(--color-white);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 0.875rem;
  }
  .process-step h3 { font-size: 1rem; margin-bottom: 4px; }
  .process-step p { color: var(--color-text-secondary); line-height: 1.6; font-size: 0.9375rem; }

  .service-cta {
    margin-top: 64px;
    padding: 48px;
    background: var(--color-bg);
    border-radius: 12px;
    text-align: center;
  }

  .service-cta h2 { margin-bottom: 12px; }
  .service-cta p {
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
</style>
