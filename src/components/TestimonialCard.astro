---
interface Props {
  testimonial: {
    quote: string;
    authorName: string;
    authorLocation?: string;
    rating?: number;
    source?: string;
  };
}

const { testimonial } = Astro.props;
const stars = testimonial.rating
  ? Array.from({ length: 5 }, (_, i) => i < testimonial.rating!)
  : [];
---

<div class="testimonial-card">
  {stars.length > 0 && (
    <div class="testimonial-stars" aria-label={`${testimonial.rating} out of 5 stars`}>
      {stars.map((filled) => (
        <span class:list={['star', { filled }]} aria-hidden="true">&#9733;</span>
      ))}
    </div>
  )}
  <blockquote class="testimonial-quote">
    "{testimonial.quote}"
  </blockquote>
  <div class="testimonial-author">
    <span class="testimonial-name">{testimonial.authorName}</span>
    {testimonial.authorLocation && (
      <span class="testimonial-location">{testimonial.authorLocation}</span>
    )}
  </div>
  {testimonial.source && (
    <span class="testimonial-source">via {testimonial.source}</span>
  )}
</div>

<style>
  .testimonial-card {
    background: var(--color-bg);
    border-radius: 8px;
    padding: 24px;
    border: 1px solid var(--color-border);
  }

  .testimonial-stars {
    margin-bottom: 12px;
  }

  .star {
    font-size: 1.125rem;
    color: var(--color-border);
  }

  .star.filled {
    color: var(--color-warning);
  }

  .testimonial-quote {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 16px;
    font-style: italic;
    border: none;
    padding: 0;
  }

  .testimonial-author {
    display: flex;
    flex-direction: column;
  }

  .testimonial-name {
    font-weight: 600;
    color: var(--color-primary);
  }

  .testimonial-location {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .testimonial-source {
    display: block;
    margin-top: 8px;
    font-size: 0.75rem;
    color: var(--color-text-light);
  }
</style>
